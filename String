class Laptop {
    String brand;
    int ram;

    Laptop(String brand, int ram) {
        this.brand = brand;
        this.ram = ram;
    }

    static class Builder {
        String brand;
        int ram;

        Builder setBrand(String brand) {
            this.brand = brand;
            return this;
        }

        Builder setRam(int ram) {
            this.ram = ram;
            return this;
        }

        Laptop build() {
            return new Laptop(brand, ram);
        }
    }
}

class Main {
    public static void main(String[] args) {
        Laptop laptop = new Laptop.Builder()
            .setBrand("Dell")
            .setRam(16)
            .build();

        System.out.println(laptop.brand + " " + laptop.ram + "GB");
    }
}