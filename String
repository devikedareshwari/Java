import java.util.*;

class Main {
    public static void main(String[] args) {
        int[] arr = {2, 4, 3, 5, 7, 8};
        int target = 10;

        Set<Integer> seen = new HashSet<>();

        for (int n : arr) {
            int required = target - n;

            if (seen.contains(required)) {
                System.out.println(required + " + " + n);
            }

            seen.add(n);
        }
    }
}