class Student {

    private String name;
    private int age;

    static class Builder {

        private String name;
        private int age;

        Builder name(String name) {
            this.name = name;
            return this;
        }

        Builder age(int age) {
            this.age = age;
            return this;
        }

        Student build() {
            Student s = new Student();
            s.name = name;
            s.age = age;
            return s;
        }
    }
}