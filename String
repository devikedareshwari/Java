import java.util.*;

class Main {
    public static void main(String[] args) {
        int[][] graph = {
            {1, 2},
            {0, 3},
            {0, 3},
            {1, 2}
        };

        int[] dist = {-1, -1, -1, -1};
        Queue<Integer> q = new ArrayDeque<>();

        q.offer(0);
        dist[0] = 0;

        while (!q.isEmpty()) {
            int node = q.poll();

            for (int next : graph[node]) {
                if (dist[next] == -1) {
                    dist[next] = dist[node] + 1;
                    q.offer(next);
                }
            }
        }

        System.out.println(Arrays.toString(dist));
    }
}