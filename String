interface Payment {
    void pay(int amount);
}

class Upi implements Payment {
    public void pay(int amount) {
        System.out.println("UPI payment: " + amount);
    }
}

class Card implements Payment {
    public void pay(int amount) {
        System.out.println("Card payment: " + amount);
    }
}

class Main {
    public static void main(String[] args) {
        Payment p = new Upi();
        p.pay(500);

        p = new Card();
        p.pay(1000);
    }
}