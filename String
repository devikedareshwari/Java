import java.util.*;

class Main {
    public static void main(String[] args) {
        String s = "{[()]}";
        Deque<Character> stack = new ArrayDeque<>();
        boolean valid = true;

        for (char c : s.toCharArray()) {
            if (c == '(' || c == '[' || c == '{') {
                stack.push(c);
            } else {
                if (stack.isEmpty()) {
                    valid = false;
                    break;
                }

                char open = stack.pop();

                if ((c == ')' && open != '(') ||
                    (c == ']' && open != '[') ||
                    (c == '}' && open != '{')) {
                    valid = false;
                    break;
                }
            }
        }

        System.out.println(valid && stack.isEmpty());
    }
}