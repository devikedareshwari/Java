class Student {
    int id = 101;
    String name = "Ravi";

    String toJson() {
        return "{\"id\":" + id +
               ",\"name\":\"" + name + "\"}";
    }
}

class Main {
    public static void main(String[] args) {
        Student s = new Student();
        System.out.println(s.toJson());
    }
}