class Main {
    public static void main(String[] args) {
        ThreadLocal<Integer> number =
            ThreadLocal.withInitial(() -> 100);

        System.out.println("Main: " + number.get());

        Thread t = new Thread(() -> {
            number.set(200);
            System.out.println("Child: " + number.get());
        });

        t.start();

        try {
            t.join();
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }

        System.out.println("Main again: " + number.get());
    }
}