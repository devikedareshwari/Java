class Main {
    public static void main(String[] args) {
        int n = 5;
        int prev2 = 1, prev1 = 1;

        for (int i = 2; i <= n; i++) {
            int current = prev1 + prev2;
            prev2 = prev1;
            prev1 = current;
        }

        System.out.println(prev1);
    }
}