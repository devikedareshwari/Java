enum Day {
    MONDAY, TUESDAY, WEDNESDAY
}

class Main {
    public static void main(String[] args) {
        Day day = Day.MONDAY;

        String type = switch (day) {
            case MONDAY -> "Start of week";
            case TUESDAY -> "Second day";
            case WEDNESDAY -> "Middle of these days";
        };

        System.out.println(type);
    }
}