import java.util.*;

class Main {
    public static void main(String[] args) {
        Set<String> books = new HashSet<>();

        books.add("Java");
        books.add("Python");
        books.add("C++");

        String requested = "Java";

        if (books.remove(requested)) {
            System.out.println("Book issued: " + requested);
        } else {
            System.out.println("Book unavailable");
        }

        System.out.println("Remaining books: " + books);
    }
}