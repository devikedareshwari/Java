import java.util.*;

class Main {
    public static void main(String[] args) {
        Stack<Integer> in = new Stack<>();
        Stack<Integer> out = new Stack<>();

        in.push(10);
        in.push(20);
        in.push(30);

        while (!in.isEmpty()) {
            out.push(in.pop());
        }

        System.out.println(out.pop());
    }
}