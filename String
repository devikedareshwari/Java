import java.util.*;

class Main {
    public static void main(String[] args) {
        int[][] graph = {
            {0, 4, 1, 0},
            {4, 0, 2, 1},
            {1, 2, 0, 5},
            {0, 1, 5, 0}
        };

        int n = graph.length;
        int[] dist = new int[n];
        boolean[] visited = new boolean[n];

        Arrays.fill(dist, Integer.MAX_VALUE);
        dist[0] = 0;

        for (int i = 0; i < n; i++) {
            int u = -1;

            for (int j = 0; j < n; j++) {
                if (!visited[j] &&
                    (u == -1 || dist[j] < dist[u])) {
                    u = j;
                }
            }

            if (u == -1 || dist[u] == Integer.MAX_VALUE)
                break;

            visited[u] = true;

            for (int v = 0; v < n; v++) {
                if (graph[u][v] > 0 && !visited[v]) {
                    dist[v] = Math.min(
                        dist[v], dist[u] + graph[u][v]
                    );
                }
            }
        }

        System.out.println(Arrays.toString(dist));
    }
}