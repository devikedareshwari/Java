class Main {
    public static void main(String[] args) {
        int[][] matrix = {
            {4, 8, 2},
            {9, 3, 7},
            {5, 6, 1}
        };

        int max = Integer.MIN_VALUE;

        for (int[] row : matrix) {
            for (int value : row) {
                max = Math.max(max, value);
            }
        }

        System.out.println(max);
    }
}